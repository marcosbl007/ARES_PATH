# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local logs and temporary files
*.log
*.tmp
tmp/
temp/

# Large NASA/geospatial inputs and generated rasters.
# Keep the directory placeholders and small metadata catalogs tracked.
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
!backend/data/processed/*.json

# Local test/export artifacts
*.sqlite3
*.db
dist/
build/
*.egg-info/
