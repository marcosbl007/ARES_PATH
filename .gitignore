# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local logs and temporary files
*.log
*.tmp
tmp/
temp/

# NASA/geospatial inputs and generated rasters.
# Raw source files under backend/data/raw are intentionally visible to Git so
# the exact inputs used to build each processed regional dataset can be shared.
backend/data/processed/*
!backend/data/processed/.gitkeep
!backend/data/processed/*.json
!backend/data/processed/jezero_fan_256_elevation.tif
!backend/data/processed/jezero_fan_256_orthoimage.tif
!backend/data/processed/jezero_fan_512_elevation.tif
!backend/data/processed/jezero_fan_512_orthoimage.tif
!backend/data/processed/jezero_fan_1024_elevation.tif
!backend/data/processed/jezero_fan_1024_orthoimage.tif
!backend/data/processed/jezero_fan_2048_elevation.tif
!backend/data/processed/jezero_fan_2048_orthoimage.tif
!backend/data/processed/jezero_ctx_*_elevation.tif
!backend/data/processed/jezero_ctx_*_orthoimage.tif

# Local test/export artifacts
*.sqlite3
*.db
backend/.pytest-tmp/
dist/
build/
*.egg-info/
